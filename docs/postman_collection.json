{
  "info": {
    "name": "Cyber Incident Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000/api/v1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dina\",\n  \"email\": \"dina@example.com\",\n  \"role\": \"analyst\"\n}"
        }
      }
    },
    {
      "name": "Create Asset",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/assets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_name\": \"Web Server\",\n  \"asset_type\": \"server\",\n  \"ip_address\": \"192.0.2.10\",\n  \"criticality\": \"high\"\n}"
        }
      }
    },
    {
      "name": "Create Incident",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/incidents",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Brute force\",\n  \"description\": \"Repeated failed logins\",\n  \"incident_type\": \"brute_force\",\n  \"severity\": \"high\",\n  \"user_id\": 1,\n  \"asset_id\": 1\n}"
        }
      }
    },
    {
      "name": "List Incidents",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/incidents?search=login&severity=high&page=1&per_page=10"
      }
    }
  ]
}